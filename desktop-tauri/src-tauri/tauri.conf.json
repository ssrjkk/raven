{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Raven AI Desktop",
  "version": "0.1.0",
  "identifier": "com.ssrjkk.raven-desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Raven AI",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://localhost:3001 http://localhost:18789 ws://localhost:18789"
    },
    "bundle": {
      "active": true,
      "targets": ["nsis", "msi"],
      "icon": ["icons/icon.ico", "icons/icon.png"],
      "resources": [
        "../services/**/*",
        "../raven/**/*.py",
        "../scripts/**/*"
      ]
    }
  }
}
