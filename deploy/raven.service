[Unit]
Description=Raven AI Personal Assistant
Documentation=https://github.com/raven-ai/raven
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/raven start
Restart=always
RestartSec=5
Environment=HOME=/root
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
