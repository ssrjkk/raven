[run]
source = raven,ravencode,aios
omit = */tests/*,*/.venv/*,*__init__*,*_pb2*,setup.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if __name__ == .__main__.
    raise NotImplementedError
    raise ImportError
    logger.exception
    logger.error
    logger.warning
    logger.debug

# measured 72% (raven only) in a clean `pip install -e ".[dev]"` env; margin covers platform skips
fail_under = 65
show_missing = True
skip_covered = False
