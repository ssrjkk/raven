      "on-status-warning": "#0b0b0d",
      "on-status-error": "#0b0b0d",
      "on-status-info": "#0b0b0d",
      "on-accent": "#ffffff"
    },
    "border": {
      "default": "rgba(236, 234, 244, 0.08)",
      "hover": "rgba(236, 234, 244, 0.16)",
      "focus": "#a78bfa",
      "muted": "rgba(236, 234, 244, 0.05)"
    },
    "status": {
      "success": "#34d399",
      "warning": "#fbbf24",
