      "amber": "#f59e0b",
      "violet": "#9a71f7",
      "pink": "#ec4899",
      "cyan": "#06b6d4",
      "orange": "#f97316",
      "teal": "#14b8a6",
      "yellow": "#eab308",
      "purple": "#a855f7",
