      "scrim": "rgba(0, 0, 0, 0.55)"
    },
    "skeleton": {
      "highlight": "rgba(236, 234, 244, 0.06)"
    }
  },
  "spacing": {
    "xs": "0.25rem",
    "sm": "0.5rem",
    "md": "1rem",
    "lg": "1.5rem",
    "xl": "2rem",
    "2xl": "3rem",
    "3xl": "4rem"
  },
  "typography": {
    "font-family": {
      "sans": "\"IBM Plex Sans\", ui-sans-serif, system-ui, \"Segoe UI\", sans-serif",
      "display": "\"Space Grotesk\", \"IBM Plex Sans\", ui-sans-serif, system-ui, sans-serif",
      "mono": "\"IBM Plex Mono\", ui-monospace, \"Cascadia Mono\", Consolas, monospace"
    },
    "font-size": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem"
    },
    "font-weight": {
      "normal": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    },
    "line-height": {
      "tight": "1.25",
      "normal": "1.5",
      "relaxed": "1.75"
    }
  },
  "border-radius": {
    "none": "0",
    "sm": "0.125rem",
    "md": "0.25rem",
    "lg": "0.375rem",
    "xl": "0.625rem",
    "full": "9999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(0,0,0,.45)",
    "md": "0 8px 24px rgba(0,0,0,.48)",
    "lg": "0 18px 48px rgba(0,0,0,.55)",
    "xl": "0 28px 72px rgba(0,0,0,.62)",
    "glow-accent": "0 0 16px rgba(139,92,246,.28)",
    "float": "0 8px 24px rgba(0,0,0,.45)"
  },
  "animation": {
    "duration": {
      "fast": "160ms",
      "normal": "320ms",
      "slow": "620ms"
    },
    "easing": {
      "default": "cubic-bezier(0.16, 1, 0.3, 1)",
      "in": "cubic-bezier(0.4, 0, 1, 1)",
      "out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  },
  "z-index": {
    "dropdown": "50",
    "sticky": "100",
    "modal": "200",
    "tooltip": "300",
    "toast": "400"
  }
}
