{
  "$schema": "https://raw.githubusercontent.com/anomalyco/raven/main/web/src/design/tokens.schema.json",
  "description": "Raven Design Tokens — single source of truth for UI styling",
  "version": "1.0.0",
  "colors": {
    "bg": {
      "primary": "#0f1117",
      "secondary": "#1a1d2e",
      "tertiary": "#252840",
      "hover": "#2a2d42",
      "active": "#323660",
      "inverse": "#ffffff"
    },
    "surface": {
      "default": "#1a1d2e",
      "elevated": "#252840",
      "card": "#1e2140",
      "tooltip": "#2a2d42",
      "modal": "#1a1d2e"
    },
    "accent": {
      "default": "#7c3aed",
      "hover": "#8b5cf6",
      "active": "#6d28d9",
      "muted": "rgba(124, 58, 237, 0.15)",
      "subtle": "rgba(124, 58, 237, 0.08)"
    },
    "text": {
      "primary": "#e4e4e7",
      "secondary": "#a1a1aa",
      "tertiary": "#71717a",
      "inverse": "#09090b",
      "link": "#8b5cf6",
      "link-hover": "#a78bfa"
    },
    "border": {
      "default": "#2a2d3e",
      "hover": "#3a3d52",
      "focus": "#7c3aed",
      "muted": "#1f2235"
    },
    "status": {
      "success": "#22c55e",
      "warning": "#eab308",
      "error": "#ef4444",
      "info": "#3b82f6",
      "success-bg": "rgba(34, 197, 94, 0.1)",
      "warning-bg": "rgba(234, 179, 8, 0.1)",
      "error-bg": "rgba(239, 68, 68, 0.1)",
      "info-bg": "rgba(59, 130, 246, 0.1)"
    }
  },
  "spacing": {
    "xs": "0.25rem",
    "sm": "0.5rem",
    "md": "1rem",
    "lg": "1.5rem",
    "xl": "2rem",
    "2xl": "3rem",
    "3xl": "4rem"
  },
  "typography": {
    "font-family": {
      "sans": "\"Inter\", system-ui, -apple-system, sans-serif",
      "mono": "\"JetBrains Mono\", \"Fira Code\", monospace"
    },
    "font-size": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem"
    },
    "font-weight": {
      "normal": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    },
    "line-height": {
      "tight": "1.25",
      "normal": "1.5",
      "relaxed": "1.75"
    }
  },
  "border-radius": {
    "none": "0",
    "sm": "0.25rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "xl": "1rem",
    "full": "9999px"
  },
  "shadow": {
    "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.3)",
    "md": "0 4px 6px -1px rgba(0, 0, 0, 0.3)",
    "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.3)",
    "xl": "0 20px 25px -5px rgba(0, 0, 0, 0.3)",
    "glow-accent": "0 0 12px rgba(124, 58, 237, 0.4)"
  },
  "animation": {
    "duration": {
      "fast": "150ms",
      "normal": "250ms",
      "slow": "400ms"
    },
    "easing": {
      "default": "cubic-bezier(0.4, 0, 0.2, 1)",
      "in": "cubic-bezier(0.4, 0, 1, 1)",
      "out": "cubic-bezier(0, 0, 0.2, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  },
  "z-index": {
    "dropdown": "50",
    "sticky": "100",
    "modal": "200",
    "tooltip": "300",
    "toast": "400"
  }
}
