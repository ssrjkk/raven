{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Raven Design Tokens Schema",
  "type": "object",
  "required": ["colors", "spacing", "typography", "border-radius", "shadow", "z-index"],
  "properties": {
    "version": { "type": "string" },
    "description": { "type": "string" },
    "colors": {
      "type": "object",
      "required": ["bg", "surface", "accent", "text", "border", "status", "chart", "category", "brand", "overlay", "skeleton"],
      "properties": {
        "bg": { "type": "object", "required": ["primary", "secondary", "tertiary", "hover", "active", "inverse"] },
        "surface": {
          "type": "object",
          "required": ["default", "elevated", "card", "tooltip", "modal", "inset-highlight"]
        },
        "accent": { "type": "object", "required": ["default", "hover", "active", "muted", "subtle"] },
        "text": {
          "type": "object",
          "required": [
            "primary", "secondary", "tertiary", "inverse", "link",
            "on-accent", "on-status-success", "on-status-warning", "on-status-error", "on-status-info"
          ]
        },
        "border": { "type": "object", "required": ["default", "hover", "focus", "muted"] },
        "status": {
          "type": "object",
          "required": ["success", "warning", "error", "info", "success-bg", "warning-bg", "error-bg", "info-bg"]
        },
        "chart": { "type": "object", "minProperties": 10 },
        "category": { "type": "object", "minProperties": 15 },
        "brand": { "type": "object", "required": ["secondary"] },
        "overlay": { "type": "object", "required": ["scrim"] },
        "skeleton": { "type": "object", "required": ["highlight"] }
      }
    },
    "spacing": { "type": "object" },
    "typography": {
      "type": "object",
      "properties": {
        "font-family": { "type": "object" },
        "font-size": { "type": "object" },
        "font-weight": { "type": "object" },
        "line-height": { "type": "object" }
      }
    },
    "border-radius": { "type": "object" },
    "shadow": { "type": "object", "required": ["md", "float"] },
    "animation": { "type": "object" },
    "z-index": { "type": "object" }
  }
}
