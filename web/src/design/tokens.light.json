{
  "$schema": "./tokens.schema.json",
  "description": "Raven Design Tokens — Light Mode",
  "version": "1.0.0",
  "colors": {
    "bg": {
      "primary": "#f7f5fb",
      "secondary": "#ffffff",
      "tertiary": "#efeaf7",
      "hover": "#e7e0f2",
      "active": "#ddd3ed",
      "inverse": "#0a0812"
    },
    "surface": {
      "default": "#ffffff",
      "elevated": "#f7f5fb",
      "card": "#ffffff",
      "tooltip": "#1a1226",
      "modal": "#ffffff",
      "inset-highlight": "rgba(22, 18, 31, 0.04)"
    },
    "accent": {
      "default": "#7c3aed",
      "hover": "#6d28d9",
      "active": "#5b21b6",
      "muted": "rgba(124, 58, 237, 0.12)",
      "subtle": "rgba(124, 58, 237, 0.06)"
    },
    "text": {
      "primary": "#16121f",
      "secondary": "#5c5468",
      "tertiary": "#746b80",
      "inverse": "#ffffff",
      "link": "#6d28d9",
      "link-hover": "#5b21b6",
      "on-status-success": "#ffffff",
      "on-status-warning": "#ffffff",
      "on-status-error": "#ffffff",
      "on-status-info": "#ffffff",
      "on-accent": "#ffffff"
    },
    "border": {
      "default": "rgba(22, 18, 31, 0.10)",
      "hover": "rgba(22, 18, 31, 0.18)",
      "focus": "#7c3aed",
      "muted": "rgba(22, 18, 31, 0.06)"
    },
    "status": {
      "success": "#0f7536",
      "warning": "#805600",
      "error": "#c81e1e",
      "info": "#2563eb",
      "success-bg": "rgba(18, 131, 60, 0.08)",
      "warning-bg": "rgba(153, 104, 3, 0.08)",
      "error-bg": "rgba(220, 38, 38, 0.08)",
      "info-bg": "rgba(37, 99, 235, 0.08)"
    },
    "chart": {
      "series-1": "#7c3aed",
      "series-2": "#be13d8",
      "series-3": "#048197",
      "series-4": "#1ca44e",
      "series-5": "#b28806",
      "series-6": "#e56a14",
      "series-7": "#ef4444",
      "series-8": "#11a090",
      "series-9": "#669d11",
      "series-10": "#3b82f6"
    },
    "category": {
      "blue": "#1e6ff5",
      "green": "#0c875e",
      "amber": "#a56a07",
      "violet": "#8452f5",
      "pink": "#e2177c",
      "cyan": "#048197",
      "orange": "#c45305",
      "teal": "#0e8478",
      "yellow": "#937105",
      "purple": "#9e42f6",
      "indigo": "#6063f1",
      "red": "#eb1414",
      "lime": "#178841",
      "slate": "#6b7280",
      "grey": "#6d7787"
    },
    "brand": {
      "secondary": "#be13d8"
    },
    "overlay": {
      "scrim": "rgba(0, 0, 0, 0.45)"
    },
    "skeleton": {
      "highlight": "rgba(22, 18, 31, 0.06)"
    }
  },
  "spacing": {
    "xs": "0.25rem",
    "sm": "0.5rem",
    "md": "1rem",
    "lg": "1.5rem",
    "xl": "2rem",
    "2xl": "3rem",
    "3xl": "4rem"
  },
  "typography": {
    "font-family": {
      "sans": "\"IBM Plex Sans\", ui-sans-serif, system-ui, \"Segoe UI\", sans-serif",
      "display": "\"Space Grotesk\", \"IBM Plex Sans\", ui-sans-serif, system-ui, sans-serif",
      "mono": "\"IBM Plex Mono\", ui-monospace, \"Cascadia Mono\", Consolas, monospace"
    },
    "font-size": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem"
    },
    "font-weight": {
      "normal": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    },
    "line-height": {
      "tight": "1.25",
      "normal": "1.5",
      "relaxed": "1.75"
    }
  },
  "border-radius": {
    "none": "0",
    "sm": "0.125rem",
    "md": "0.25rem",
    "lg": "0.375rem",
    "xl": "0.625rem",
    "full": "9999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(22,18,31,.05)",
    "md": "0 8px 24px rgba(22,18,31,.08)",
    "lg": "0 18px 48px rgba(22,18,31,.10)",
    "xl": "0 28px 72px rgba(22,18,31,.12)",
    "glow-accent": "0 0 16px rgba(124,58,237,.16)",
    "float": "0 8px 24px rgba(22,18,31,.12)"
  },
  "animation": {
    "duration": {
      "fast": "160ms",
      "normal": "320ms",
      "slow": "620ms"
    },
    "easing": {
      "default": "cubic-bezier(0.16, 1, 0.3, 1)",
      "in": "cubic-bezier(0.4, 0, 1, 1)",
      "out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  },
  "z-index": {
    "dropdown": "50",
    "sticky": "100",
    "modal": "200",
    "tooltip": "300",
    "toast": "400"
  }
}
