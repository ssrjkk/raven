{
  "$schema": "./tokens.schema.json",
  "description": "Raven Design Tokens — Light Mode",
  "version": "1.0.0",
  "colors": {
    "bg": {
      "primary": "#f4f2fa",
      "secondary": "#ffffff",
      "tertiary": "#eae6f5",
      "hover": "#e2dcf0",
      "active": "#d6cfe8",
      "inverse": "#0a0812"
    },
    "surface": {
      "default": "#ffffff",
      "elevated": "#f1eef9",
      "card": "#ffffff",
      "tooltip": "#1a1226",
      "modal": "#ffffff",
      "inset-highlight": "rgba(26, 21, 38, 0.05)",
      "paper": "#ffffff"
    },
    "accent": {
      "default": "#7c3aed",
      "hover": "#6d28d9",
      "active": "#5b21b6",
      "muted": "rgba(124, 58, 237, 0.12)",
      "subtle": "rgba(124, 58, 237, 0.06)"
    },
    "text": {
      "primary": "#1a1526",
      "secondary": "#4d4660",
      "tertiary": "#655e78",
      "inverse": "#ffffff",
      "link": "#6d28d9",
      "link-hover": "#5b21b6",
      "on-status-success": "#ffffff",
      "on-status-warning": "#ffffff",
      "on-status-error": "#ffffff",
      "on-status-info": "#ffffff",
      "on-category-blue": "#ffffff",
      "on-category-green": "#ffffff",
      "on-category-amber": "#ffffff",
      "on-category-violet": "#ffffff",
      "on-category-pink": "#ffffff",
      "on-category-grey": "#ffffff",
      "on-accent": "#ffffff"
    },
    "border": {
      "default": "rgba(26, 21, 38, 0.12)",
      "hover": "rgba(26, 21, 38, 0.22)",
      "focus": "#7c3aed",
      "muted": "rgba(26, 21, 38, 0.07)"
    },
    "status": {
      "success": "#147337",
      "warning": "#7e6105",
      "error": "#c21d1d",
      "info": "#225bd8",
      "success-bg": "rgba(21, 122, 58, 0.08)",
      "warning-bg": "rgba(133, 102, 5, 0.08)",
      "error-bg": "rgba(200, 30, 30, 0.08)",
      "info-bg": "rgba(37, 99, 235, 0.08)"
    },
    "chart": {
      "series-1": "#8b5cf6",
      "series-2": "#ca41de",
      "series-3": "#058ca3",
      "series-4": "#1a9446",
      "series-5": "#a17c06",
      "series-6": "#cf5f12",
      "series-7": "#ea4343",
      "series-8": "#109183",
      "series-9": "#5c8f0f",
      "series-10": "#397eef"
    },
    "category": {
      "blue": "#1e6ff5",
      "green": "#0c875e",
      "amber": "#a56a07",
      "violet": "#8452f5",
      "pink": "#e2177c",
      "cyan": "#048197",
      "orange": "#c45305",
      "teal": "#0e8478",
      "yellow": "#937105",
      "purple": "#9e42f6",
      "indigo": "#6063f1",
      "red": "#eb1414",
      "lime": "#178841",
      "slate": "#6b7280",
      "grey": "#6d7787"
    },
    "brand": {
      "secondary": "#ab37bd"
    },
    "overlay": {
      "scrim": "rgba(0, 0, 0, 0.45)"
    },
    "skeleton": {
      "highlight": "rgba(26, 21, 38, 0.08)"
    }
  },
  "spacing": {
    "xs": "0.25rem",
    "sm": "0.5rem",
    "md": "1rem",
    "lg": "1.5rem",
    "xl": "2rem",
    "2xl": "3rem",
    "3xl": "4rem"
  },
  "typography": {
    "font-family": {
      "sans": "\"IBM Plex Sans\", ui-sans-serif, system-ui, \"Segoe UI\", sans-serif",
      "display": "\"Space Grotesk\", \"IBM Plex Sans\", ui-sans-serif, system-ui, \"Segoe UI\", sans-serif",
      "mono": "\"IBM Plex Mono\", ui-monospace, \"Cascadia Mono\", Consolas, monospace"
    },
    "font-size": {
      "micro": "0.625rem",
      "caption": "0.6875rem",
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "display": "4.5rem"
    },
    "font-weight": {
      "normal": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    },
    "line-height": {
      "tight": "1.25",
      "normal": "1.5",
      "relaxed": "1.75"
    }
  },
  "border-radius": {
    "none": "0",
    "sm": "4px",
    "md": "6px",
    "lg": "8px",
    "xl": "12px",
    "full": "9999px"
  },
  "shadow": {
    "sm": "0 1px 2px 0 rgba(16, 18, 27, 0.05)",
    "md": "0 4px 8px -1px rgba(16, 18, 27, 0.07)",
    "lg": "0 10px 18px -3px rgba(16, 18, 27, 0.08)",
    "xl": "0 24px 32px -8px rgba(16, 18, 27, 0.1)",
    "glow-accent": "0 0 12px rgba(124, 58, 237, 0.2)",
    "float": "0 4px 16px rgba(15, 17, 23, 0.16)"
  },
  "animation": {
    "duration": {
      "fast": "160ms",
      "normal": "320ms",
      "slow": "620ms"
    },
    "easing": {
      "default": "cubic-bezier(0.16, 1, 0.3, 1)",
      "in": "cubic-bezier(0.4, 0, 1, 1)",
      "out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  },
  "z-index": {
    "dropdown": "50",
    "sticky": "100",
    "modal": "200",
    "tooltip": "300",
    "toast": "400"
  }
}
