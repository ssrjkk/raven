{
  "$schema": "./tokens.schema.json",
  "description": "Raven Design Tokens — Light Mode",
  "version": "1.0.0",
  "colors": {
    "bg": {
      "primary": "#f6f7fb",
      "secondary": "#ffffff",
      "tertiary": "#eef0f6",
      "hover": "#e7e9f1",
      "active": "#dde0ea",
      "inverse": "#0f1117"
    },
    "surface": {
      "default": "#ffffff",
      "elevated": "#f1f3f8",
      "card": "#ffffff",
      "tooltip": "#1a1d2e",
      "modal": "#ffffff",
      "inset-highlight": "rgba(0, 0, 0, 0.04)"
    },
    "accent": {
      "default": "#7c3aed",
      "hover": "#6d28d9",
      "active": "#5b21b6",
      "muted": "rgba(124, 58, 237, 0.1)",
      "subtle": "rgba(124, 58, 237, 0.05)"
    },
    "text": {
      "primary": "#17171d",
      "secondary": "#52525c",
      "tertiary": "#707080",
      "inverse": "#ffffff",
      "link": "#7c3aed",
      "link-hover": "#6d28d9",
      "on-status-success": "#ffffff",
      "on-status-warning": "#ffffff",
      "on-status-error": "#ffffff",
      "on-status-info": "#ffffff",
      "on-accent": "#ffffff"
    },
    "border": {
      "default": "#e5e7ee",
      "hover": "#d3d6e0",
      "focus": "#7c3aed",
      "muted": "#f0f1f6"
    },
    "status": {
      "success": "#12833c",
      "warning": "#996803",
      "error": "#dc2626",
      "info": "#2563eb",
      "success-bg": "rgba(18, 131, 60, 0.08)",
      "warning-bg": "rgba(153, 104, 3, 0.08)",
      "error-bg": "rgba(220, 38, 38, 0.08)",
      "info-bg": "rgba(37, 99, 235, 0.08)"
    },
    "chart": {
      "series-1": "#7c3aed",
      "series-2": "#d946ef",
      "series-3": "#059db6",
      "series-4": "#1ca44e",
      "series-5": "#b28806",
      "series-6": "#e56a14",
      "series-7": "#ef4444",
      "series-8": "#11a090",
      "series-9": "#669d11",
      "series-10": "#3b82f6"
    },
    "category": {
      "blue": "#1e6ff5",
      "green": "#0c875e",
      "amber": "#a56a07",
      "violet": "#8452f5",
      "pink": "#e2177c",
      "cyan": "#048197",
      "orange": "#c45305",
      "teal": "#0e8478",
      "yellow": "#937105",
      "purple": "#9e42f6",
      "indigo": "#6063f1",
      "red": "#eb1414",
      "lime": "#178841",
      "slate": "#6b7280",
      "grey": "#6d7787"
    },
    "brand": {
      "secondary": "#be13d8"
    },
    "overlay": {
      "scrim": "rgba(0, 0, 0, 0.45)"
    },
    "skeleton": {
      "highlight": "rgba(0, 0, 0, 0.06)"
    }
  },
  "spacing": {
    "xs": "0.25rem",
    "sm": "0.5rem",
    "md": "1rem",
    "lg": "1.5rem",
    "xl": "2rem",
    "2xl": "3rem",
    "3xl": "4rem"
  },
  "typography": {
    "font-family": {
      "sans": "\"Inter\", system-ui, -apple-system, sans-serif",
      "mono": "\"JetBrains Mono\", \"Fira Code\", monospace"
    },
    "font-size": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem"
    },
    "font-weight": {
      "normal": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    },
    "line-height": {
      "tight": "1.25",
      "normal": "1.5",
      "relaxed": "1.75"
    }
  },
  "border-radius": {
    "none": "0",
    "sm": "0.25rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "xl": "1rem",
    "full": "9999px"
  },
  "shadow": {
    "sm": "0 1px 2px 0 rgba(16, 18, 27, 0.05)",
    "md": "0 4px 8px -1px rgba(16, 18, 27, 0.07)",
    "lg": "0 10px 18px -3px rgba(16, 18, 27, 0.08)",
    "xl": "0 24px 32px -8px rgba(16, 18, 27, 0.1)",
    "glow-accent": "0 0 12px rgba(124, 58, 237, 0.2)",
    "float": "0 4px 16px rgba(15, 17, 23, 0.16)"
  },
  "animation": {
    "duration": {
      "fast": "150ms",
      "normal": "250ms",
      "slow": "400ms"
    },
    "easing": {
      "default": "cubic-bezier(0.4, 0, 0.2, 1)",
      "in": "cubic-bezier(0.4, 0, 1, 1)",
      "out": "cubic-bezier(0, 0, 0.2, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  },
  "z-index": {
    "dropdown": "50",
    "sticky": "100",
    "modal": "200",
    "tooltip": "300",
    "toast": "400"
  }
}
