# Build-time variables for the web bundle (Vite reads VITE_* at build, not at run time).
# Every name here must be one web/src reads through import.meta.env.


# Browser tracing: the OTLP HTTP endpoint of your collector. The development
# stack maps jaeger's 4318. Left empty, no tracer is loaded at all.
VITE_OTEL_ENDPOINT=
