{
  "rules": [
    {
      "name": "deny-dangerous-tools",
      "condition": {
        "or": [
          {"tool": "api.http_post"},
          {"tool": "sessions.sessions_spawn"},
          {"tool": "process.kill"},
          {"tool": "process.run"},
          {"tool": "process.run_python"},
          {"tool": "git.git_push"},
          {"tool": "git.git_pull"}
        ]
      },
      "effect": "deny",
      "priority": 100
    },
    {
      "name": "deny-automation-group",
      "condition": {
        "match": {"field": "tool", "pattern": "^group:automation"}
      },
      "effect": "deny",
      "priority": 90
    },
    {
      "name": "allow-messaging-tools",
      "condition": {
        "or": [
          {"tool": "files.read", "profile": "messaging"},
          {"tool": "memory.recall", "profile": "messaging"},
          {"tool": "memory.search_memory", "profile": "messaging"},
          {"tool": "browser.search", "profile": "messaging"}
        ]
      },
      "effect": "allow",
      "priority": 50
    },
    {
      "name": "deny-exec-by-default",
      "condition": {
        "exec_security": "deny"
      },
      "effect": "deny",
      "priority": 10
    },
    {
      "name": "allow-ask-with-confirm",
      "condition": {
        "exec_security": "ask"
      },
      "effect": "allow",
      "priority": 20
    }
  ]
}
