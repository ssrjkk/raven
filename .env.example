# LLM Providers (choose at least one)
OPENROUTER_API_KEY=sk-or-...
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
OLLAMA_BASE_URL=http://localhost:11434

# Default model
DEFAULT_MODEL=openrouter/openai/gpt-4o

# Telegram
TELEGRAM_BOT_TOKEN=

# Discord
DISCORD_BOT_TOKEN=

# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=

# Matrix
MATRIX_HOMESERVER=https://matrix.org
MATRIX_ACCESS_TOKEN=

# Security
DM_POLICY=pairing
WEB_SECRET_KEY=change-me-in-production
CHANNEL_ALLOW_FROM=

# Agent workspace
WORKSPACE_PATH=workspace

# Database
DB_PATH=data/raven.db

# Web UI
WEB_PORT=18888
WEB_CORS_ORIGINS=*
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60

# LLM
LLM_TIMEOUT=120
LLM_RETRY_MAX=3
LLM_RETRY_DELAY=1.0

# Logging
LOG_LEVEL=INFO
JSON_LOG=true
LOG_FILE=data/raven.log
