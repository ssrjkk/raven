# ── LLM Providers ──────────────────────────────────────────────
# WARNING: Do NOT use the placeholder keys below in production.
# They are WATERMARK tokens — if they appear in logs we will know
# exactly which build was leaked.
OPENROUTER_API_KEY=sk-or-...
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk-...
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=                     # vLLM / OpenAI-compatible local server
LLM_LOCAL_BASE_MODEL=              # base model id for the in-process "local" provider
LLM_LOCAL_ADAPTER_PATH=            # directory with the LoRA adapter trained by /api/finetune
LLM_LOCAL_MAX_NEW_TOKENS=256
LLM_LOCAL_REVISION=main            # Hugging Face revision the local provider loads — a commit id, not "main", is reproducible

# Default model
DEFAULT_MODEL=openrouter/openai/gpt-4o

# Bundled free experimental model (uncensored Qwen3.5-9B, apache-2.0, 5.63 GB Q4_K_M).
# Not vendored in git: `raven models enable-heretic` pulls it into Ollama and writes the switch,
# `raven start` only checks that the weights are there. Uncomment to point at it by hand instead:
# DEFAULT_MODEL=ollama/hf.co/mradermacher/DeepSeek-V4-Pro-Qwen3.5-9B-UNCENSORED-heretic-GGUF:Q4_K_M
# MODEL_FAST=ollama/hf.co/mradermacher/DeepSeek-V4-Pro-Qwen3.5-9B-UNCENSORED-heretic-GGUF:Q4_K_M
# HERETIC_REF=hf.co/mradermacher/DeepSeek-V4-Pro-Qwen3.5-9B-UNCENSORED-heretic-GGUF:Q4_K_M
# HERETIC_MODEL=ollama/hf.co/mradermacher/DeepSeek-V4-Pro-Qwen3.5-9B-UNCENSORED-heretic-GGUF:Q4_K_M

# Truthful Orchestrator (Chain-of-Verification) — model + optional dedicated provider
CRITICAL_MODEL=                  # model for critical thinking (falls back to DEFAULT_MODEL)
CRITICAL_PROVIDER=               # e.g. openrouter / openai / anthropic — dedicated provider for critical calls
CRITICAL_API_KEY=                # API key for the dedicated critical provider
# The RAVEN_CRITICAL_MODEL / RAVEN_CRITICAL_PROVIDER / RAVEN_CRITICAL_API_KEY
# spellings are still accepted as aliases (CRITICAL_* wins if both are set).

# Model tiers (auto-discovered per tier when empty)
MODEL_FAST=
MODEL_BALANCED=
MODEL_QUALITY=

# Master key for secrets encryption
RAVEN_MASTER_KEY=

# === Channels ===

# Telegram
TELEGRAM_BOT_TOKEN=

# Discord
DISCORD_BOT_TOKEN=

# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=

# WhatsApp (Graph API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=          # Meta app secret; verifies X-Hub-Signature-256 on inbound posts
WHATSAPP_VERIFY_TOKEN=        # token set in the Meta dashboard; checked against the GET handshake

# Matrix
MATRIX_HOMESERVER=https://matrix.org
MATRIX_ACCESS_TOKEN=

# Google Chat
GOOGLECHAT_WEBHOOK_URL=

# Signal (signal-cli REST API)
SIGNAL_API_URL=http://localhost:8080

# IRC
IRC_SERVER=irc.libera.chat
IRC_PORT=6697
# TLS is implied by the port (6697/6699/7000 = on, 6667 = off); set IRC_TLS=0/1 to override
IRC_TLS=
IRC_NICK=raven-bot
IRC_PASSWORD=
IRC_CHANNELS=#raven

# Microsoft Teams
TEAMS_WEBHOOK_URL=

# Feishu/Lark
FEISHU_WEBHOOK_URL=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ENCRYPT_KEY=           # verifies X-Lark-Signature on inbound event callbacks

# LINE
LINE_CHANNEL_TOKEN=
LINE_CHANNEL_SECRET=

# Email (needs: pip install 'raven-agent[email]')
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=
EMAIL_IMAP_PASS=
EMAIL_INBOX_FOLDER=INBOX
EMAIL_POLL_INTERVAL=30

# === Security ===
DM_POLICY=pairing               # pairing | closed | open
WEB_SECRET_KEY=change-me-in-production
CHANNEL_ALLOW_FROM=

# Tool Security Policy (OpenClaw-compat)
# TOOLS_DENY, TOOLS_ALLOW and EXEC_SECURITY are checked on the agent path, the orchestrator
# (webchat) path, task steps and both MCP transports, from one builder (policy_from_settings).
TOOLS_PROFILE=messaging         # messaging | minimal | full - plugin-tool allow-list, agent path
# Leave TOOLS_DENY empty to keep the built-in default list. A value REPLACES it, and only real
# tool names match: plugin tools are dotted (sessions.sessions_spawn, process.run, git.git_push),
# registry tools are underscored (shell, python, nodes_exec, git_push, http_post). group:automation
# is a rule name in policy/tools.json, not a tool, so naming it in TOOLS_DENY denies nothing.
TOOLS_DENY=
TOOLS_ALLOW=
EXEC_SECURITY=deny              # deny | ask | full — gate for exec-class tools (shell, python, browser, MCP, plugin, git writes, db_query)
EXEC_ASK_MODE=always            # off | on-miss | always — with ask and no confirmer wired, the tool denies instead of running
WORKSPACE_ONLY=true             # confine every file, git, OCR and exec path argument to the workspace root below
CONTEXT_VISIBILITY=all          # all | allowlist | allowlist_quote

# Sandbox
SANDBOX_MODE=non-main           # main | non-main | all | none
SANDBOX_BACKEND=subprocess      # subprocess | docker | none

# The workspace root: the one directory every file, git, OCR and exec path argument is confined to.
# A relative value is taken from the directory the process starts in; leave it unset to confine to
# that directory itself. RAVEN_WORKSPACE, when set, wins over this. `raven doctor` prints the root
# and which setting decided it.
WORKSPACE_PATH=workspace

# Database
DB_PATH=data/raven.db

# Web UI
WEB_PORT=18888
WEB_HOST=127.0.0.1                # bind address — use 0.0.0.0 only behind a firewall/reverse proxy
RAVENFLOW_PORT=18789              # RavenFlow gateway websocket/HTTP port
RAVENFLOW_HOST=127.0.0.1          # RavenFlow bind address — use 0.0.0.0 only behind a firewall/reverse proxy
RAVEN_WEB_DIST=                   # explicit path to the built dashboard (else web/dist is auto-discovered)
WEB_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:18888
# '*' is refused while WEB_CORS_ALLOW_CREDENTIALS=on: credentialed CORS answers with the caller's
# own Origin, so a wildcard here would let any site read a logged-in user's responses. A wildcard
# subdomain (https://*.example.com) is matched literally and matches nothing, so it is refused too.
WEB_CORS_ALLOW_CREDENTIALS=1      # set 0 for a public API, which is the only case '*' is allowed
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60
# Which address a request is billed to. X-Forwarded-For is honoured from a peer this project installed
# (loopback, 10/8, 172.16/12, 192.168/16, fc00::/7) either way. Set 1 only when something off-host —
# a cloud load balancer, a proxy on another machine — terminates the connection for us.
TRUST_FORWARDED_FOR=0

# LLM
LLM_TIMEOUT=120
LLM_RETRY_MAX=3
LLM_RETRY_DELAY=1.0
LLM_MAX_CONCURRENT=10              # in-flight LLM requests (queue beyond this)
LLM_QUEUE_TIMEOUT=5.0              # seconds a queued request waits before failing

# Agent loop timeouts (seconds)
AGENT_TOKEN_TIMEOUT=30             # per-token stream stall timeout
AGENT_TOOL_TIMEOUT=120             # per-tool-call timeout

# === Search Providers (optional) ===
BRAVE_SEARCH_API_KEY=
PERPLEXITY_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_CSE_ID=
BING_SEARCH_API_KEY=
TAVILY_SEARCH_API_KEY=

# === GitHub Integration ===
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=      # verifies inbound GitHub webhook signatures

# CI/CD Integration
GITLAB_TOKEN=
GITLAB_URL=https://gitlab.com
GITLAB_WEBHOOK_SECRET=            # verifies inbound GitLab webhook signatures
JENKINS_URL=
JENKINS_USER=
JENKINS_TOKEN=

# Media Generation
REPLICATE_API_TOKEN=              # For Stable Diffusion via Replicate

# === OAuth / SSO (web login) ===
OAUTH_REDIRECT_BASE=http://localhost:5173
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=

# Observability
METRICS_PORT=9090                 # metrics exporter port used by the gateway
OTLP_ENDPOINT=                    # OTLP HTTP collector, e.g. http://localhost:4318

# Redis (caching / rate-limit backing)
REDIS_URL=

# Postgres (optional, replaces SQLite)
DATABASE_URL=

# === Context Window (auto-compaction) ===
CONTEXT_WINDOW_ENABLED=true
CONTEXT_WINDOW_MAX_TOKENS=128000
CONTEXT_WINDOW_WARNING_THRESHOLD=0.8          # fraction of the budget that warns
CONTEXT_WINDOW_SUMMARIZATION_THRESHOLD=0.9    # fraction that triggers summarization
CONTEXT_WINDOW_HARD_LIMIT=0.95                # fraction that forces compaction
CONTEXT_WINDOW_RESERVED_TOKENS=2000           # headroom kept for the reply
CONTEXT_WINDOW_SLIDING_SIZE=20                # recent turns kept verbatim
TOKEN_BUDGET_PER_HOUR=500000                  # per-user input+output hourly budget
GHOST_MODE=false                              # local-only mode (Ollama, no cloud calls)

# === Channel send resilience (bulkhead + circuit breaker) ===
CHANNEL_SEND_CONCURRENCY=4                    # max concurrent in-flight sends per channel
CHANNEL_SEND_TIMEOUT=30                       # per-send timeout (seconds)
CHANNEL_SEND_FAILURE_THRESHOLD=5              # consecutive failures before the circuit opens
CHANNEL_SEND_RECOVERY_TIMEOUT=30              # seconds before a half-open probe

# === MCP / plugin registry ===
MCP_SERVERS=                                  # JSON list of MCP servers
CHANNEL_SANDBOX_POLICY=                       # JSON map, e.g. {"telegram":"non-main","discord":"code-exec"}
PLUGIN_REGISTRY_URL=                          # base URL/directory of the plugin catalog

# === Fine-tuning ===
# Importable is not consent: the corpus builder drops rows added without consented=true and runs
# PII/credential redaction over the rows it keeps, and training publishes nothing unless this is on.
# With it on, TrainingMonitor logs metrics AND uploads checkpoint directories as W&B artifacts.
RAVEN_TRAIN_TRACKING=off        # on | off — mirror training runs to api.wandb.ai

# Logging
LOG_LEVEL=INFO
JSON_LOG=true
LOG_FILE=data/raven.log

# === Feature toggles ===
# Read from .raven/features.yaml (then raven.yaml) under a `features:` key; the environment
# wins over the file. Accepted values: on|off|1|0|true|false|yes|no - anything else is logged
# and ignored. `raven doctor` prints the set that is actually on. Turning a flag off removes
# exactly the surface named in docs/configuration.md, so the defaults are left uncommented
# only where the feature is on by default.
RAVEN_FEATURE_SKILLS=on            # off: built-in skills only, skill search dirs not read
RAVEN_FEATURE_PLANNER=on           # off: the /api/task/* endpoints are not registered
RAVEN_FEATURE_DELEGATION=on        # off: delegated tasks always go to the coder profile
# RAVEN_FEATURE_DREAMING=off       # on: lets the dreaming engine run
# RAVEN_FEATURE_BROWSER=off        # on: mounts the browser router
# RAVEN_FEATURE_VOICE=off          # on: mounts the voice router
# RAVEN_FEATURE_TELEMETRY=off      # on: mounts the analytics and A/B-testing routers

# === ravencode overrides ===
# The `ravencode` CLI and its TUI read these over their config files; the names above
# configure the gateway. RAVENCODE_CONFIG_CONTENT is parsed in memory and never written
# to disk, which is the point of passing a configuration that holds secrets this way.
# RAVENCODE_MODEL=ollama/qwen2.5-coder
# RAVENCODE_TEMPERATURE=0.2       # float; a value that is not a number is reported and ignored
# RAVENCODE_MAX_STEPS=30          # int; tool rounds a single task may spend
# RAVENCODE_THEME=opencode        # TUI theme name
# RAVENCODE_CONFIG_CONTENT=       # a whole config.json body, inline
# RAVEN_SMART_ROUTING=0           # anything but 1 skips the live LLM call that routes a task
