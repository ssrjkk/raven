# LLM Providers (choose at least one)
OPENROUTER_API_KEY=sk-or-...
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
OLLAMA_BASE_URL=http://localhost:11434

# Default model
DEFAULT_MODEL=openrouter/anthropic/claude-3-haiku

# Telegram
TELEGRAM_BOT_TOKEN=

# Discord
DISCORD_BOT_TOKEN=

# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Security
ALLOWED_USERS=
DM_POLICY=pairing

# Database
DB_PATH=~/.raven/raven.db
VECTOR_DB_PATH=~/.raven/chroma

# Web UI
WEB_PORT=18888
WEB_SECRET_KEY=change-me-in-production

# Logging
LOG_LEVEL=INFO
LOG_FILE=~/.raven/raven.log
