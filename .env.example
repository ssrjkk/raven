# LLM Providers (choose at least one)
OPENROUTER_API_KEY=sk-or-...
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
OLLAMA_BASE_URL=http://localhost:11434

# Default model
DEFAULT_MODEL=openrouter/openai/gpt-4o

# Master key for secrets encryption
RAVEN_MASTER_KEY=

# === Channels ===

# Telegram
TELEGRAM_BOT_TOKEN=

# Discord
DISCORD_BOT_TOKEN=

# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=

# WhatsApp (Graph API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Matrix
MATRIX_HOMESERVER=https://matrix.org
MATRIX_ACCESS_TOKEN=

# Google Chat
GOOGLECHAT_WEBHOOK_URL=

# Signal (signal-cli REST API)
SIGNAL_API_URL=http://localhost:8080

# IRC
IRC_SERVER=irc.libera.chat
IRC_PORT=6697
IRC_NICK=raven-bot
IRC_PASSWORD=
IRC_CHANNELS=#raven

# Microsoft Teams
TEAMS_WEBHOOK_URL=

# Feishu/Lark
FEISHU_WEBHOOK_URL=
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# LINE
LINE_CHANNEL_TOKEN=
LINE_CHANNEL_SECRET=

# === Security ===
DM_POLICY=pairing               # pairing | closed | open
WEB_SECRET_KEY=change-me-in-production
CHANNEL_ALLOW_FROM=

# Tool Security Policy (OpenClaw-compat)
TOOLS_PROFILE=messaging         # messaging | minimal | full
TOOLS_DENY=group:automation,group:runtime,sessions_spawn,shell.exec,browser.control
TOOLS_ALLOW=
EXEC_SECURITY=deny              # deny | ask | full
EXEC_ASK_MODE=always            # off | on-miss | always
WORKSPACE_ONLY=true             # restrict FS to WORKSPACE_PATH
CONTEXT_VISIBILITY=all          # all | allowlist | allowlist_quote

# Sandbox
SANDBOX_MODE=non-main           # main | non-main | all | none
SANDBOX_BACKEND=subprocess      # subprocess | docker | none

# Agent workspace
WORKSPACE_PATH=workspace

# Database
DB_PATH=data/raven.db

# Web UI
WEB_PORT=18888
WEB_CORS_ORIGINS=*
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60

# LLM
LLM_TIMEOUT=120
LLM_RETRY_MAX=3
LLM_RETRY_DELAY=1.0

# NATS Messaging
NATS_URL=nats://localhost:4222
NATS_TOKEN=

# JWT Authentication
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# OpenTelemetry / Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=raven
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=raven

# LLM Provider (alternative single-key format)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# gRPC / Protobuf
GRPC_PORT=50051

# Prometheus Metrics
PROMETHEUS_PORT=9090
METRICS_ENABLED=true

# Redis (caching / rate-limit backing)
REDIS_URL=

# Postgres (optional, replaces SQLite)
DATABASE_URL=

# Daemon
DAEMON_PID_PATH=/var/run/ravend.pid
DAEMON_LOG_LEVEL=info

# Feature flags
FEATURE_CODING_ASSISTANT=true
FEATURE_RAG=true
FEATURE_TASK_ENGINE=true
FEATURE_MONITORS=true
FEATURE_ROUTINES=true

# Logging
LOG_LEVEL=INFO
JSON_LOG=true
LOG_FILE=data/raven.log
