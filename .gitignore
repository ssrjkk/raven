# Local stale snapshots of this repo, untracked on purpose: they are a pre-0.4.8 copy whose
# commit is already in main's history, and 125k files here must never reach `git add -A`.
raven_old*/

# Session exports the chat UI writes into the working tree, named `<topic>_<date>_<hh-mm>.md`. They are
# conversation transcripts, not documentation, and the one present while this rule was added weighed
# 46,412,860 bytes at the repository root — untracked, so a single `git add -A` would have put it in
# history permanently, where no later checkout can drop it. Root-anchored: `docs/` keeps its own dates.
/*_20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]_[0-9][0-9]-[0-9][0-9].md
