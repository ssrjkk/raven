{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist"
  },
  "include": ["ai-core/**/*.ts", "agents/**/*.ts", "runtime/**/*.ts", "repo/**/*.ts", "shared/**/*.ts"]
}
