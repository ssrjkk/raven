#!/usr/bin/env bash
# Raven AI CLI installer — by ssrjkk
# Installs the `raven` command from PyPI (pipx preferred, pip --user fallback).
#
# Usage:
#   ./install              # latest from PyPI
#   ./install 0.4.8        # pinned version
#
# Alternatives: Docker (`docker compose up -d`), Windows EXE (GitHub Actions
# artifact `Raven.exe`), or from source (`pip install -e ".[dev]"`).
set -euo pipefail

REQ_VERSION="${1:-latest}"
PKG="raven-agent"
if [ "$REQ_VERSION" != "latest" ]; then
  PKG="raven-agent==${REQ_VERSION#v}"
fi

echo "Installing Raven AI ($PKG) — by ssrjkk ..."

if command -v pipx >/dev/null 2>&1; then
  pipx install --force "$PKG"
  echo "[+] Installed with pipx. Verify: raven doctor"
  exit 0
fi

PYTHON="${PYTHON:-python3}"
if ! command -v "$PYTHON" >/dev/null 2>&1; then
  echo "[!] python3 not found — install Python 3.11+ first" >&2
  exit 1
fi

"$PYTHON" -m pip install --user --upgrade "$PKG"
echo "[+] Installed with pip --user. Verify: raven doctor"
echo "    If 'raven' is not on PATH: export PATH=\"\$HOME/.local/bin:\$PATH\""

